---
// Premier Cardiovascular Associates -- homepage
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Premier Cardiovascular Associates — A steady hand for your heart</title>
<meta name="description" content="Premier Cardiovascular Associates provides traditional and specialized heart and vascular care for patients of all ages in Lombard, IL, led by Dr. Mumtaz.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --ink:#16233A;
    --paper:#F1F3F1;
    --white:#FFFFFF;
    --pulse:#B23A32;
    --steel:#2E5F6B;
    --mist:#8B98A1;
    --line:#DADFDD;
    --radius:4px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans',sans-serif;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{
    font-family:'Fraunces',serif;
    font-weight:500;
    margin:0 0 .4em 0;
    letter-spacing:-0.01em;
  }
  .eyebrow{
    font-family:'IBM Plex Mono',monospace;
    font-size:.72rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--pulse);
    display:flex;
    align-items:center;
    gap:.5em;
    margin-bottom:.9em;
  }
  .eyebrow::before{
    content:"";
    width:18px;height:1px;background:var(--pulse);
    display:inline-block;
  }
  a{color:inherit;}
  img,svg{display:block;max-width:100%;}
  .wrap{max-width:1120px;margin:0 auto;padding:0 32px;}
  :focus-visible{outline:2px solid var(--steel);outline-offset:3px;}
  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important;}
  }

  /* ---------- NAV ---------- */
  header{
    position:sticky;top:0;z-index:40;
    background:rgba(241,243,241,.92);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }
  nav.wrap{
    display:flex;align-items:center;justify-content:space-between;
    padding-top:18px;padding-bottom:18px;
  }
  .wordmark{
    display:flex;align-items:center;gap:10px;
    font-family:'Fraunces',serif;font-weight:600;font-size:1.15rem;
    text-decoration:none;color:var(--ink);
  }
  .wordmark small{
    display:block;font-family:'IBM Plex Mono',monospace;
    font-size:.6rem;letter-spacing:.1em;color:var(--mist);font-weight:400;
    text-transform:uppercase;
  }
  .navlinks{display:flex;gap:28px;list-style:none;margin:0;padding:0;font-size:.92rem;}
  .navlinks a{text-decoration:none;color:var(--ink);opacity:.75;transition:opacity .15s;}
  .navlinks a:hover{opacity:1;}
  .call-btn{
    font-family:'IBM Plex Mono',monospace;font-size:.82rem;
    background:var(--ink);color:var(--paper);
    padding:10px 18px;border-radius:var(--radius);
    text-decoration:none;white-space:nowrap;
  }
  .navwrap-right{display:flex;align-items:center;gap:28px;}
  @media (max-width:820px){ .navlinks{display:none;} }

  /* ---------- HERO ---------- */
  .hero{padding:88px 0 0 0;}
  .hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center;}
  @media (max-width:900px){ .hero-grid{grid-template-columns:1fr;} }
  .hero h1{font-size:clamp(2.1rem,4.4vw,3.3rem);line-height:1.06;}
  .hero p.lede{font-size:1.08rem;color:#3c4a5c;max-width:46ch;margin:0 0 28px 0;}
  .cta-row{display:flex;gap:14px;flex-wrap:wrap;}
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    padding:13px 22px;border-radius:var(--radius);
    text-decoration:none;font-size:.92rem;font-weight:500;
    transition:transform .15s ease, background .15s ease;
  }
  .btn-primary{background:var(--pulse);color:#fff;}
  .btn-primary:hover{background:#9c332c;transform:translateY(-1px);}
  .btn-ghost{border:1px solid var(--ink);color:var(--ink);}
  .btn-ghost:hover{background:var(--ink);color:var(--paper);}

  .hero-badge{
    background:var(--white);border:1px solid var(--line);border-radius:var(--radius);
    padding:24px;
  }
  .hero-badge .avatar-ring{width:96px;height:96px;margin:0 auto 14px;}
  .hero-badge h3{font-size:1.05rem;text-align:center;margin-bottom:2px;}
  .hero-badge .role{text-align:center;color:var(--mist);font-size:.85rem;margin-bottom:16px;}
  .hero-badge ul{list-style:none;margin:0;padding:0;font-size:.85rem;}
  .hero-badge li{
    display:flex;justify-content:space-between;padding:9px 0;
    border-top:1px solid var(--line);font-family:'IBM Plex Mono',monospace;
  }
  .hero-badge li span:first-child{color:var(--mist);}

  /* ---------- PULSE DIVIDER (signature element) ---------- */
  .pulse-divider{
    position:relative;margin:72px 0;height:64px;
  }
  .pulse-divider svg{width:100%;height:100%;overflow:visible;}
  .pulse-path{
    fill:none;stroke:var(--pulse);stroke-width:2;
    stroke-dasharray:900;stroke-dashoffset:900;
  }
  .pulse-divider.inview .pulse-path{
    animation:draw 1.6s ease forwards;
  }
  @keyframes draw{ to{stroke-dashoffset:0;} }
  .pulse-label{
    position:absolute;top:0;
    font-family:'IBM Plex Mono',monospace;font-size:.72rem;color:var(--ink);
    background:var(--paper);padding:0 8px;transform:translateX(-50%);
    opacity:0;
  }
  .pulse-divider.inview .pulse-label{ opacity:1; transition:opacity .4s ease .9s; }
  .pulse-label .num{color:var(--pulse);font-weight:500;}

  /* ---------- SECTION HEADS ---------- */
  section{padding:0 0 8px 0;}
  .section-head{max-width:60ch;margin-bottom:44px;}
  .section-head h2{font-size:clamp(1.6rem,3vw,2.1rem);}
  .section-head p{color:#3c4a5c;font-size:1rem;}

  /* ---------- SERVICES ---------- */
  .services-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:1px;
    background:var(--line);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;
  }
  @media (max-width:820px){ .services-grid{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:560px){ .services-grid{grid-template-columns:1fr;} }
  .service-card{
    background:var(--white);padding:26px 22px;
  }
  .service-card .icon{width:34px;height:34px;color:var(--steel);margin-bottom:14px;}
  .service-card h3{font-size:1rem;font-family:'IBM Plex Sans',sans-serif;font-weight:600;margin-bottom:6px;}
  .service-card p{font-size:.88rem;color:#54606d;margin:0;}

  /* ---------- ABOUT ---------- */
  .about-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:56px;align-items:start;}
  @media (max-width:820px){ .about-grid{grid-template-columns:1fr;} }
  .avatar-ring{position:relative;}
  .avatar-ring svg{width:100%;}
  .cred-list{list-style:none;margin:22px 0 0;padding:0;font-size:.9rem;}
  .cred-list li{
    padding:10px 0;border-top:1px solid var(--line);
    display:flex;gap:10px;
  }
  .cred-list li::before{content:"—";color:var(--pulse);}

  /* ---------- TESTIMONIALS ---------- */
  .testi-row{
    display:flex;gap:20px;overflow-x:auto;padding-bottom:8px;
    scroll-snap-type:x proximity;
  }
  .testi-card{
    scroll-snap-align:start;
    flex:0 0 320px;background:var(--white);border:1px solid var(--line);border-radius:var(--radius);
    padding:24px;
  }
  .testi-card .mark{color:var(--pulse);font-family:'Fraunces',serif;font-size:1.8rem;line-height:1;}
  .testi-card p{font-size:.92rem;color:#33404f;min-height:96px;}
  .testi-card .who{font-family:'IBM Plex Mono',monospace;font-size:.75rem;color:var(--mist);}

  /* ---------- HOURS / LOCATION ---------- */
  .hours-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;}
  @media (max-width:820px){ .hours-grid{grid-template-columns:1fr;} }
  table.hours{width:100%;border-collapse:collapse;font-family:'IBM Plex Mono',monospace;font-size:.9rem;}
  table.hours td{padding:11px 0;border-top:1px solid var(--line);}
  table.hours td:last-child{text-align:right;color:var(--steel);}
  .map-card{
    background:var(--white);border:1px solid var(--line);border-radius:var(--radius);
    padding:22px;
  }
  .map-card .map-svg{width:100%;height:180px;background:var(--paper);border-radius:var(--radius);margin-bottom:16px;}
  .map-card address{font-style:normal;font-size:.92rem;line-height:1.6;}

  /* ---------- FOOTER ---------- */
  footer{background:var(--ink);color:#c7d0d8;margin-top:96px;padding:56px 0 34px;}
  .footer-grid{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:40px;}
  @media (max-width:700px){ .footer-grid{grid-template-columns:1fr;} }
  footer h4{font-family:'IBM Plex Mono',monospace;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:#8fa0ac;margin:0 0 14px;}
  footer ul{list-style:none;margin:0;padding:0;font-size:.88rem;}
  footer li{margin-bottom:8px;}
  footer a{text-decoration:none;color:#c7d0d8;}
  footer a:hover{color:#fff;}
  .footer-bottom{
    margin-top:48px;padding-top:22px;border-top:1px solid rgba(255,255,255,.12);
    display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;
    font-size:.78rem;color:#7d8b96;font-family:'IBM Plex Mono',monospace;
  }
</style>
</head>
<body>

<header>
  <nav class="wrap">
    <a class="wordmark" href="#top">
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none"><path d="M13 22s-8.5-5.2-11-11.2C.6 6.7 2.7 3 6.6 3c2.4 0 4.2 1.3 6.4 4 2.2-2.7 4-4 6.4-4 3.9 0 6 3.7 4.6 7.8C21.5 16.8 13 22 13 22Z" stroke="#B23A32" stroke-width="1.6"/></svg>
      Premier Cardiovascular<small>Associates · Lombard, IL</small>
    </a>
    <div class="navwrap-right">
      <ul class="navlinks">
        <li><a href="#services">Services</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#testimonials">Patients say</a></li>
        <li><a href="#visit">Hours &amp; Location</a></li>
      </ul>
      <a class="call-btn" href="tel:16304816161">630 · 481 · 6161</a>
    </div>
  </nav>
</header>

<main id="top">

  <!-- HERO -->
  <section class="hero wrap">
    <div class="hero-grid">
      <div>
        <div class="eyebrow">Cardiac care · Lombard, Illinois</div>
        <h1>A steady hand<br>for your heart.</h1>
        <p class="lede">Premier Cardiovascular Associates provides traditional and specialized heart and vascular care for patients of all ages, led by Dr. Mumtaz and a team focused on one thing: your rhythm.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#visit">Request an appointment</a>
          <a class="btn btn-ghost" href="tel:16304816161">Call (630) 481-6161</a>
        </div>
      </div>
      <div class="hero-badge">
        <div class="avatar-ring">
          <svg viewBox="0 0 96 96" width="96" height="96">
            <circle cx="48" cy="48" r="46" fill="none" stroke="#DADFDD" stroke-width="1.5"/>
            <circle cx="48" cy="48" r="36" fill="#EDEFEE"/>
            <path d="M48 30c-9 0-16 6.5-16 15 0 12 16 24 16 24s16-12 16-24c0-8.5-7-15-16-15Z" fill="none" stroke="#2E5F6B" stroke-width="1.6"/>
          </svg>
        </div>
        <h3>Dr. Mumtaz</h3>
        <div class="role">Cardiologist, PCA</div>
        <ul>
          <li><span>Location</span><span>Lombard, IL</span></li>
          <li><span>Focus</span><span>Cardiovascular care</span></li>
          <li><span>New patients</span><span>Welcome</span></li>
        </ul>
      </div>
    </div>

    <div class="pulse-divider" data-pulse>
      <svg viewBox="0 0 1000 64" preserveAspectRatio="none">
        <path class="pulse-path" d="M0 32 H360 L390 8 L415 56 L440 20 L460 32 H1000"/>
      </svg>
      <span class="pulse-label" style="left:44%">care built around <span class="num">you</span>, not the clock</span>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="wrap" id="services">
    <div class="section-head">
      <div class="eyebrow">What we treat</div>
      <h2>A closer look at how we help.</h2>
      <p>From routine screening to complex arrhythmia management, this is a sample of the care we provide — if you don't see your concern listed, call us and ask.</p>
    </div>

    <div class="services-grid">
      <div class="service-card">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12h4l2 6 4-14 2 8h6"/></svg>
        <h3>Arrhythmias</h3>
        <p>Comprehensive management program for irregular heart rhythms.</p>
      </div>
      <div class="service-card">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-4.4-9.3-9.4C1.4 7.9 3.4 4.8 6.8 4.8c2 0 3.6 1.1 5.2 3.3 1.6-2.2 3.2-3.3 5.2-3.3 3.4 0 5.4 3.1 4.1 6.8C19 16.6 12 21 12 21Z"/></svg>
        <h3>Congestive Heart Failure</h3>
        <p>Treatment focused on strong outcomes even where conditions can't be reversed.</p>
      </div>
      <div class="service-card">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
        <h3>Hypertension</h3>
        <p>Individualized plans to lower and stabilize blood pressure.</p>
      </div>
      <div class="service-card">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12h4l1.5-4L12 17l2-8 1.5 3H20"/></svg>
        <h3>Coronary Artery Disease</h3>
        <p>Relieving symptoms and reducing risk factors with proven approaches.</p>
      </div>
      <div class="service-card">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3v6a6 6 0 0 0 12 0V3M6 21v-6a6 6 0 0 1 12 0v6"/></svg>
        <h3>Peripheral Vascular Disease</h3>
        <p>Managing symptoms and halting progression of vascular disease.</p>
      </div>
      <div class="service-card">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3v10M7 8l5-5 5 5M5 15h14l-1 6H6l-1-6Z"/></svg>
        <h3>Cholesterol &amp; Lipid Mgmt</h3>
        <p>Advanced treatment options for patients with severe lipid disorders.</p>
      </div>
      <div class="service-card">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2a5 5 0 0 0-5 5c0 3 5 8 5 8s5-5 5-8a5 5 0 0 0-5-5Z"/><path d="M6 15c-2 1-3 2-3 3.5C3 20.5 7 22 12 22s9-1.5 9-3.5c0-1.5-1-2.5-3-3.5"/></svg>
        <h3>Coumadin Management</h3>
        <p>Careful monitoring to prevent heart attacks, strokes and blood clots.</p>
      </div>
      <div class="service-card">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 3h6l1 4H8l1-4Z"/><path d="M6 7h12l-1 14H7L6 7Z"/></svg>
        <h3>Preoperative Testing</h3>
        <p>Pre-surgery diagnostics that minimize risk before elective procedures.</p>
      </div>
      <div class="service-card">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12h5l2-8 4 16 2-8h5"/></svg>
        <h3>Cardiac Screening</h3>
        <p>Screening that can serve as an early wake-up call for at-risk patients.</p>
      </div>
    </div>

    <div class="pulse-divider" data-pulse>
      <svg viewBox="0 0 1000 64" preserveAspectRatio="none">
        <path class="pulse-path" d="M0 32 H500 L525 6 L550 58 L575 32 H1000"/>
      </svg>
      <span class="pulse-label" style="left:54%">and much more, case by case</span>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="wrap" id="about">
    <div class="about-grid">
      <div>
        <div class="avatar-ring">
          <svg viewBox="0 0 240 240" width="100%">
            <rect width="240" height="240" rx="4" fill="#EDEFEE"/>
            <circle cx="120" cy="96" r="40" fill="none" stroke="#2E5F6B" stroke-width="2"/>
            <path d="M60 210c8-38 34-58 60-58s52 20 60 58" fill="none" stroke="#2E5F6B" stroke-width="2"/>
            <path d="M20 140 H90 L100 118 L114 158 L126 132 L136 140 H220" fill="none" stroke="#B23A32" stroke-width="1.6"/>
          </svg>
        </div>
        <ul class="cred-list">
          <li>Practicing cardiologist, Lombard, IL</li>
          <li>Focus on traditional &amp; specialized heart care</li>
          <li>Serves patients of all ages</li>
          <li>Accepting new patients</li>
        </ul>
      </div>
      <div>
        <div class="eyebrow">About your doctor</div>
        <h2>Committed to a higher level of cardiac care.</h2>
        <p style="color:#3c4a5c;max-width:60ch;">Dr. Mumtaz and the team at Premier Cardiovascular Associates built this practice around a simple idea: patients do best when their cardiologist has time for them. That shows up in appointments that aren't rushed, follow-up that doesn't push unnecessary treatment, and a willingness to work patients into the schedule when something can't wait.</p>
        <p style="color:#3c4a5c;max-width:60ch;">The practice treats the full range of cardiovascular conditions — from routine cholesterol management to complex arrhythmias — with the same close, personal attention regardless of how common or rare the diagnosis.</p>
        <a class="btn btn-ghost" href="#visit" style="margin-top:8px;">Plan a visit</a>
      </div>
    </div>

    <div class="pulse-divider" data-pulse>
      <svg viewBox="0 0 1000 64" preserveAspectRatio="none">
        <path class="pulse-path" d="M0 32 H260 L285 10 L305 54 L325 32 H1000"/>
      </svg>
      <span class="pulse-label" style="left:31%">patient-first, since day one</span>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="wrap" id="testimonials">
    <div class="section-head">
      <div class="eyebrow">In patients' words</div>
      <h2>What it's like to be seen here.</h2>
    </div>
    <div class="testi-row">
      <div class="testi-card">
        <div class="mark">"</div>
        <p>Good Doc, very experienced in field. Was a great experience, very humble and caring. Gave a good explanation of the causes and very honest.</p>
        <div class="who">— Mohammed Hussain</div>
      </div>
      <div class="testi-card">
        <div class="mark">"</div>
        <p>Worked me into his schedule at the end of the day, and yet spent long quality time diagnosing and discussing options with me. Thoroughly professional and caring.</p>
        <div class="who">— Dave Long</div>
      </div>
      <div class="testi-card">
        <div class="mark">"</div>
        <p>It was great. He and his team are very thorough.</p>
        <div class="who">— Delaina</div>
      </div>
      <div class="testi-card">
        <div class="mark">"</div>
        <p>He and the staff were very pleasant and did an excellent job.</p>
        <div class="who">— James</div>
      </div>
      <div class="testi-card">
        <div class="mark">"</div>
        <p>Outstanding visit as always. The care and concern is consistently shown — a true professional.</p>
        <div class="who">— Henry B.</div>
      </div>
    </div>
  </section>

  <!-- HOURS / LOCATION -->
  <section class="wrap" id="visit" style="margin-top:88px;">
    <div class="section-head">
      <div class="eyebrow">Plan your visit</div>
      <h2>Hours &amp; location.</h2>
    </div>
    <div class="hours-grid">
      <div>
        <table class="hours">
          <tr><td>Monday</td><td>8:00 – 12:00</td></tr>
          <tr><td>Tuesday</td><td>Closed</td></tr>
          <tr><td>Wednesday</td><td>8:00 – 12:00</td></tr>
          <tr><td>Thursday</td><td>Closed</td></tr>
          <tr><td>Friday</td><td>Closed</td></tr>
          <tr><td>Saturday</td><td>8:00 – 12:00</td></tr>
          <tr><td>Sunday</td><td>Closed</td></tr>
        </table>
        <p style="font-size:.85rem;color:var(--mist);margin-top:14px;">Don't see a time that works? Call the office and we'll try to find one.</p>
      </div>
      <div class="map-card">
        <svg class="map-svg" viewBox="0 0 400 180">
          <rect width="400" height="180" fill="#E9ECEA"/>
          <path d="M0 120 H400 M0 90 H400 M140 0 V180 M260 0 V180" stroke="#DADFDD" stroke-width="1"/>
          <circle cx="200" cy="90" r="7" fill="#B23A32"/>
          <circle cx="200" cy="90" r="14" fill="none" stroke="#B23A32" stroke-width="1.4" opacity=".5"/>
        </svg>
        <address>
          Premier Cardiovascular Associates<br>
          1320 S. Main St., Suite 304<br>
          Lombard, IL 60148<br><br>
          <strong>Phone:</strong> <a href="tel:16304816161">1-630-481-6161</a><br>
          <strong>Email:</strong> <a href="mailto:premiercardiologist@gmail.com">premiercardiologist@gmail.com</a>
        </address>
      </div>
    </div>
  </section>

</main>

<footer>
  <div class="wrap footer-grid">
    <div>
      <h4>Premier Cardiovascular Associates</h4>
      <p style="max-width:34ch;font-size:.9rem;color:#a9b6bf;">Traditional and specialized heart and vascular care for patients of all ages, in Lombard, Illinois.</p>
    </div>
    <div>
      <h4>Practice</h4>
      <ul>
        <li><a href="#services">Services</a></li>
        <li><a href="#about">About Dr. Mumtaz</a></li>
        <li><a href="#visit">Hours &amp; location</a></li>
      </ul>
    </div>
