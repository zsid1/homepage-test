<script is:inline>
  const dividers = document.querySelectorAll('[data-pulse]');
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){ e.target.classList.add('inview'); io.unobserve(e.target); }
    });
  }, {threshold:.4});
  dividers.forEach(d=>io.observe(d));
</script>

